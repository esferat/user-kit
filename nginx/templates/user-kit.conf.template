# Application logs of the edge, written in addition to the stdout stream of the
# container so Logstash can ship them to Elasticsearch. The access log is JSON,
# which keeps it parseable, the error log keeps the nginx format.
log_format userkit_json escape=json
    '{'
      '"time":"$time_iso8601",'
      '"remote_addr":"$remote_addr",'
      '"method":"$request_method",'
      '"scheme":"$scheme",'
      '"host":"$host",'
      '"uri":"$request_uri",'
      '"status":$status,'
      '"bytes":$body_bytes_sent,'
      '"request_time":$request_time,'
      '"upstream_addr":"$upstream_addr",'
      '"upstream_status":"$upstream_status",'
      '"referer":"$http_referer",'
      '"user_agent":"$http_user_agent"'
    '}';

access_log /var/log/user-kit-nginx/access.log userkit_json;
error_log  /var/log/user-kit-nginx/error.log warn;

upstream frontend_upstream {
    # Single frontend reverse proxy: frontend-main serves the application.
    server ${UPSTREAM_FRONTEND_MAIN};
    keepalive 16;
}

upstream user_profile_upstream {
    # Producer of the profile microfrontend: its own Node server and its BFF.
    server ${UPSTREAM_USER_PROFILE};
    keepalive 16;
}

upstream backend_upstream {
    server ${UPSTREAM_BACKEND};
    keepalive 16;
}

# Identity provider for all domains. The issuer of the tokens is the same origin:
# https://${SERVER_NAME:-user-kit.local}/auth/realms/user-kit, so a login started on
# user-kit.local or user-kit.next.local shares the cookie and state. Only the
# canonical domain hosts /auth; other projects redirect here at /api/v1/auth/login.
upstream keycloak_upstream {
    server ${UPSTREAM_KEYCLOAK};
    keepalive 8;
}

upstream kibana_upstream {
    server ${UPSTREAM_KIBANA};
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME} ${SERVER_NAME_NEXT} ${SERVER_NAME_PROFILE} ${SERVER_NAME_KIBANA};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

# Shared parts of the application domains. Everything but the frontend
# root is identical: the same backend serves all of them, and the cookies are
# host only, so a session of one domain never leaks into the other.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size ${MAX_UPLOAD_SIZE};
    charset utf-8;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    location = /v3/api-docs {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /swagger-ui {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Keycloak is served under /auth so that the issuer of the tokens is the
    # same origin as the application, which keeps the browser flow free of
    # third party cookies and CORS exceptions. Only the canonical domain hosts
    # it.
    location /auth/ {
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;
        proxy_intercept_errors off;
    }

    # BFF of the profile microfrontend. It is proxied on the canonical domain so
    # the Module Federation component, rendered inside this origin, keeps its
    # calls same-origin: the session cookie is host only and is never sent to
    # another domain.
    location /profile-api/ {
        proxy_pass http://user_profile_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}


# Second application domain: a Next.js full stack application. Same API and the
# same redirect of /auth to the canonical domain, but the asset and page requests
