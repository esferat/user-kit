# Copy to .env and adjust. Never commit the real file.
# cp .env.example .env

# Public host names of the edge nginx container. They serve the same backend but
# are independent applications: the session cookies are host only, so a login of
# one domain stays on that domain. The first host is canonical: it also hosts
# the identity provider under /auth.
SERVER_NAME=user-kit.local

SERVER_NAME_MUI=user-kit.mui.local
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL
DATABASE_NAME=userkit
DATABASE_USERNAME=userkit
DATABASE_PASSWORD=userkit

# Object storage (Silo in docker compose, any S3 compatible storage in production)
# SILO_IMAGE exists for environments that cannot pull pgsty/silo from Docker Hub.
SILO_IMAGE=pgsty/silo
SILO_VERSION=latest
S3_BUCKET=user-kit
S3_REGION=us-east-1
S3_ACCESS_KEY=siloadmin
S3_SECRET_KEY=siloadmin
# Host port of the Silo console, the S3 API stays inside the compose network
SILO_CONSOLE_PORT=9001
# true lets the backend create the bucket on startup, keep it false if the bucket exists already
S3_CREATE_BUCKET=true

# Spring profile of the backend. Only "dev" adds SQL logging.
SPRING_PROFILES_ACTIVE=dev
# Fills an empty store with sample documents, dev profile only.
DEMO_DATA_ENABLED=true
BACKEND_PORT=8080
MAX_UPLOAD_SIZE=26m

# Local Keycloak, imported from keycloak/realm/user-kit-realm.json on first start.
KEYCLOAK_VERSION=26.4
# Bootstrap admin of the Keycloak container, not a user of the application.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Direct host port for the Keycloak dev server, the application itself only uses
# the /auth prefix on SERVER_NAME.
KEYCLOAK_PORT=8180
# Realm path, served below SERVER_NAME/auth.
KEYCLOAK_RELATIVE_PATH=/auth
# Must contain SERVER_NAME and KEYCLOAK_RELATIVE_PATH, otherwise the issuer that
# Keycloak advertises does not match the URL the browser and backend use. Only
# the canonical domain hosts the provider, the other domains redirect to it.
KEYCLOAK_HOSTNAME=https://user-kit.ant.local/auth

# Identity provider: the local Keycloak of docker compose. Any OpenID Connect
# provider with the same claims works as well.
OIDC_ENABLED=true
OIDC_ISSUER_URI=https://user-kit.ant.local/auth/realms/user-kit
# Keys are fetched over the docker network, the issuer above stays the public URL.
OIDC_JWK_SET_URI=http://keycloak:8080/auth/realms/user-kit/protocol/openid-connect/certs
OIDC_AUDIENCES=user-kit-api
OIDC_ROLES_CLAIM=roles

# Local token issuer for backend tests, only available with DEV_AUTH_ENABLED=true.
# Set it to false to accept tokens of the identity provider only.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Frontend build arguments. Vite inlines VITE_* at build time, so changing them
# requires "docker compose up -d --build frontend".
# The login method comes from the backend, so there is no auth mode to choose.
VITE_DEV_ROLE=admin
VITE_API_BASE_URL=
VITE_UI5_THEME=sap_horizon
VITE_ANTD_THEME=light
VITE_MUI_THEME=light
# ru or en, the user can switch the language in the shell bar.
VITE_DEFAULT_LOCALE=ru

# Browser login. The backend is the OAuth client: it performs the authorization
# code exchange and keeps the refresh token, the browser only gets httpOnly
# cookies. The frontend itself needs no identity provider configuration anymore.
# Must match the confidential client user-kit-bff of the realm. Every redirect URI
# of that client has to be listed there, the plain HTTP ones are for Vite on
# :5173, :5174 and :5175.
OIDC_CLIENT_ENABLED=true
OIDC_CLIENT_ID=user-kit-bff
OIDC_CLIENT_SECRET=user-kit-bff-dev-secret-change-me
# Discovery happens over the docker network, the tokens still come from the
# public issuer above.
OIDC_CLIENT_ISSUER_URI=http://keycloak:8080/auth/realms/user-kit
# One entry per frontend domain, comma separated. A login continues on the domain
# it started on and the state row keeps the exact callback of that login, so the
# exchange sends the same redirect_uri the provider saw.
OIDC_CLIENT_REDIRECT_URIS=https://user-kit.ant.local/api/v1/auth/callback,https://user-kit.ant.local/api/v1/auth/callback,https://user-kit.mui.local/api/v1/auth/callback
# Frontend roots the provider may send the browser to after a logout.
OIDC_CLIENT_POST_LOGOUT_REDIRECT_URIS=https://user-kit.ant.local/,https://user-kit.ant.local/,https://user-kit.mui.local/
# Fallback of the lists above, used when a login state predates the lists.
OIDC_CLIENT_REDIRECT_URI=https://user-kit.ant.local/api/v1/auth/callback
OIDC_CLIENT_POST_LOGOUT_REDIRECT_URI=https://user-kit.ant.local/
OIDC_CLIENT_SCOPES=openid profile email
# How long a started login may take, and how long a session survives without use.
OIDC_LOGIN_STATE_TTL=10m
OIDC_SESSION_TTL=12h
# false for plain HTTP on localhost, true for any HTTPS deployment.
OIDC_COOKIE_SECURE=false
# Optional cookie domain, leave empty to scope the cookies to the host only.
OIDC_COOKIE_DOMAIN=
# Renew the access token when it expires within this window.
OIDC_REFRESH_WINDOW=90s
