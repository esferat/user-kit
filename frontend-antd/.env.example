# Copy to .env.local or .env and adjust. Vite only exposes variables prefixed with VITE_.
# cp .env.example .env.local

# Empty means "same origin", which is the default behind the nginx edge container.
# Set it when the API is on another host, for example http://localhost:8080 while
# developing with "npm run dev". That origin also has to be in APP_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# UI5 theme
VITE_UI5_THEME=sap_horizon

# Language of the interface, ru or en. The choice of the user is remembered in
# localStorage and wins over this value.
VITE_DEFAULT_LOCALE=ru

# Role requested from POST /api/v1/auth/dev-login, used by the local login of the
# dev profile only.
VITE_DEV_ROLE=admin

# There is no login mode here on purpose. The frontend asks GET /api/v1/auth/config
# which methods the backend offers, so identity provider settings live in the
# backend environment (see .env.example in the repository root).