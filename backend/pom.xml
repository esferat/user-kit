<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.acme</groupId>
    <artifactId>user-kit-backend</artifactId>
    <version>0.1.0</version>
    <name>user-kit-backend</name>
    <description>Backend of user-kit: OIDC secured file storage with REST JSON API</description>

    <properties>
        <java.version>21</java.version>
        <aws.sdk.version>2.56.0</aws.sdk.version>
        <springdoc.version>3.1.1</springdoc.version>

        <!-- Security overrides: Spring Boot 4.1.1 already manages patched
             versions of most transitive dependencies. Jackson 3 (used by the
             web layer and Flyway), Jackson 2 (still pulled in by
             springdoc/swagger), Tomcat and Logback are the ones that trail the
             upstream security fixes.

             Jackson 3.2.3 requires jackson-annotations 2.22, and the Jackson 2
             BOM is imported first, so it has to be 2.22.3 as well. Otherwise,
             jackson-annotations is pinned to 2.21 and Flyway fails at startup
             with ClassNotFoundException: com.fasterxml.jackson.annotation.JsonApplyView.

             Logback 1.5.38 (Boot 4.1.1's managed version) is affected by the
             MDC/discriminator path-traversal issues CVE-2026-19880 (fixed in
             1.6.3) and CVE-2026-104721 (fixed in 1.6.5). The 1.6.x line is a
             drop-in replacement for 1.5.x and is what Boot 4.2 already ships,
             but it needs SLF4J 2.0.19 instead of the 2.0.18 managed by 4.1.1.

             Netty 4.2.17.Final (Boot 4.1.1's managed version, pulled in by the
             AWS SDK's netty-nio-client) has a batch of HTTP codec flaws:
             CVE-2026-93488/-93558/-93565 (SPDY and WebSocket unbounded resource
             use, RTSP method smuggling) and the request-smuggling CVEs
             CVE-2026-89044/-93573/-93566, all fixed upstream in 4.2.18.Final.
             Boot imports io.netty:netty-bom via ${netty.version}, so this single
             property moves every Netty module in lockstep. -->
        <jackson-bom.version>3.2.3</jackson-bom.version>
        <jackson-2-bom.version>2.22.3</jackson-2-bom.version>
        <tomcat.version>11.0.27</tomcat.version>
        <logback.version>1.6.5</logback.version>
        <netty.version>4.2.18.Final</netty.version>
        <slf4j.version>2.0.19</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Boot 4 moved the RestClient.Builder auto-configuration out of the
             web starter, the OAuth client injects the builder. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Client side of the OAuth login: the backend exchanges the code itself.
             The bare library is enough, the starter would only add auto configuration. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc auto-configuration lives in its own module in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory database for the HTTP integration tests. The production
             stack keeps PostgreSQL; H2 runs the same JPQL without Docker. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
