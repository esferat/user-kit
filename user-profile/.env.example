# Copy to .env for local development. Never commit the real file.

# Public address of this microfrontend. It is inlined at BUILD time into
# mf-manifest.json as the publicPath of the remote, so changing it requires a
# rebuild of the image.
PROFILE_ASSET_PREFIX=https://user-kit.profile.local

# Backend address the BFF routes call. Read at RUN time, container only.
BACKEND_BASE_URL=http://backend:8080

# Port of the built-in Modern.js server (the edge proxies its domain here).
PORT=3001
